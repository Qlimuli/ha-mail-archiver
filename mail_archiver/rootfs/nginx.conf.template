worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    client_max_body_size 0;
    client_body_timeout 3600s;
    send_timeout 3600s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    map $http_x_ingress_path $ingress_prefix {
        default $http_x_ingress_path;
        ""      "";
    }

    map $host $fwd_proto {
        ~*\.ts\.net$   https;
        ~*tailscale    https;
        default        $http_x_forwarded_proto;
    }
    map $fwd_proto $real_proto {
        default $fwd_proto;
        ""      $scheme;
    }

    map $host $ha_sec_inject {
        default '<script src="ha-ui-inject.js?v=140" defer></script>';
    }

    server {
        listen 5000 default_server;
        server_name _;

        location = /ha-ui-inject.js {
            alias /ha-ui-inject.js;
            default_type application/javascript;
            add_header Cache-Control "no-store";
        }
        location ~ ^/api/hassio_ingress/[^/]+/ha-ui-inject\.js(?:\?.*)?$ {
            alias /ha-ui-inject.js;
            default_type application/javascript;
            add_header Cache-Control "no-store";
        }

        location /security/ {
            proxy_pass http://127.0.0.1:5002/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_read_timeout 120s;
        }
        location = /security {
            return 302 $ingress_prefix/security/;
        }

        location ~ ^/api/hassio_ingress/[^/]+/security/(?<secrest>.*)$ {
            proxy_pass http://127.0.0.1:5002/$secrest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_read_timeout 120s;
        }

        location ~ ^/api/hassio_ingress/[^/]+(?<rest>/.*)$ {
            proxy_pass http://127.0.0.1:5001$rest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect https://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;
            proxy_redirect ~^https?://[^/]+/(?<rpath>.*)$ $ingress_prefix/$rpath;
            proxy_cookie_path / $ingress_prefix/;
            proxy_cookie_flags ~ nosecure samesite=lax;
            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter 'data-email-url="/' 'data-email-url="$ingress_prefix/';
            sub_filter "data-email-url='/" "data-email-url='$ingress_prefix/";
            sub_filter 'window.location.href="/' 'window.location.href="$ingress_prefix/';
            sub_filter "window.location.href='/" "window.location.href='$ingress_prefix/";
            sub_filter 'window.location="/' 'window.location="$ingress_prefix/';
            sub_filter "window.location='/" "window.location='$ingress_prefix/";
            sub_filter '</body>' '$ha_sec_inject</body>';
            sub_filter '</BODY>' '$ha_sec_inject</BODY>';
        }

        location / {
            proxy_pass http://127.0.0.1:5001;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix $ingress_prefix;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect https://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;
            proxy_redirect ~^https?://[^/]+/(?<rpath>.*)$ $ingress_prefix/$rpath;
            proxy_cookie_path / $ingress_prefix/;
            proxy_cookie_flags ~ nosecure samesite=lax;
            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter 'data-email-url="/' 'data-email-url="$ingress_prefix/';
            sub_filter "data-email-url='/" "data-email-url='$ingress_prefix/";
            sub_filter 'window.location.href="/' 'window.location.href="$ingress_prefix/';
            sub_filter "window.location.href='/" "window.location.href='$ingress_prefix/";
            sub_filter 'window.location="/' 'window.location="$ingress_prefix/';
            sub_filter "window.location='/" "window.location='$ingress_prefix/";
            sub_filter '</body>' '$ha_sec_inject</body>';
            sub_filter '</BODY>' '$ha_sec_inject</BODY>';
        }
    }
}

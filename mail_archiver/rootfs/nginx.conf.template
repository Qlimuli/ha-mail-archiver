worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    client_max_body_size 0;
    client_body_timeout 3600s;
    send_timeout 3600s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    map $http_x_ingress_path $ingress_prefix {
        default $http_x_ingress_path;
        ""      "";
    }

    # Script: Sicherheit in Top-Navbar (nur Admin) + EML-Upload-Fix
    map $host $ha_sec_inject {
        default '<script id="ha-sec-inject">(function(){function go(){try{if(document.getElementById("ha-sec-nav"))return true;var nav=document.querySelector("nav.navbar")||document.querySelector("nav")||document.querySelector("header");if(!nav)return false;var txt=nav.textContent||"";if(!/Benutzer|Users/i.test(txt))return false;var ul=nav.querySelector("ul.navbar-nav")||nav.querySelector("ul");if(!ul)return false;var anchors=[].slice.call(nav.querySelectorAll("a.nav-link,a"));var proto=null;for(var i=0;i<anchors.length;i++){var t=(anchors[i].textContent||"").replace(/\\s+/g," ").trim();if(/Protokoll|\\bLog\\b|Logs/i.test(t)){proto=anchors[i];break;}}var a=document.createElement("a");a.id="ha-sec-nav";a.className=(proto&&proto.className)?proto.className.replace(/\\bactive\\b/g,"").trim()||"nav-link":"nav-link";if(a.className.indexOf("nav-link")<0)a.className+=" nav-link";a.href="security/";a.title="Sicherheit (Admin)";a.innerHTML="<i class=\\"bi bi-shield-check me-1\\"></i>Sicherheit";var li=document.createElement("li");li.className="nav-item";li.appendChild(a);if(proto){var p=proto.parentElement;if(p&&p.tagName==="LI"){p.parentElement.insertBefore(li,p.nextSibling);}else{proto.parentElement.insertBefore(a,proto.nextSibling);}}else{ul.appendChild(li);}return true;}catch(e){return false;}}function start(){if(go())return;var n=0;var t=setInterval(function(){if(go()||++n>40)clearInterval(t);},250);try{var mo=new MutationObserver(function(){if(go())mo.disconnect();});mo.observe(document.documentElement,{childList:true,subtree:true});setTimeout(function(){try{mo.disconnect();}catch(e){}},15000);}catch(e){}}function fixEml(){try{var input=document.getElementById("emlFileInput");if(!input)return;var form=document.getElementById("emlImportForm");var btn=document.getElementById("submitBtn");if(!form||!btn)return;if(!document.getElementById("ha-eml-upload-btn")){var wrap=document.createElement("div");wrap.className="mb-2 d-flex align-items-center gap-2 flex-wrap";var uBtn=document.createElement("button");uBtn.type="button";uBtn.id="ha-eml-upload-btn";uBtn.className="btn btn-outline-primary";uBtn.innerHTML="<i class=\\"bi bi-folder2-open me-1\\"></i>Datei wählen (ZIP mit EMLs)";uBtn.onclick=function(){input.click();};var nameSpan=document.createElement("span");nameSpan.id="ha-eml-filename";nameSpan.className="text-muted small";nameSpan.style.display="none";input.style.position="absolute";input.style.width="1px";input.style.height="1px";input.style.opacity="0";input.style.overflow="hidden";input.parentNode.insertBefore(wrap,input);wrap.appendChild(uBtn);wrap.appendChild(nameSpan);wrap.appendChild(input);}function update(){var hasFile=input.files&&input.files.length>0;var sel=document.getElementById("accountSelect");var hasAcc=sel&&sel.value;btn.disabled=!(hasFile&&hasAcc);var ns=document.getElementById("ha-eml-filename");if(ns){if(hasFile){ns.textContent=input.files[0].name;ns.style.display="inline";}else{ns.style.display="none";}}}input.addEventListener("change",update);var sel=document.getElementById("accountSelect");if(sel)sel.addEventListener("change",update);update();form.addEventListener("submit",function(){btn.disabled=true;btn.innerHTML="<i class=\\"bi bi-hourglass-split me-2\\"></i>Upload läuft …";});}catch(e){}}function startAll(){start();fixEml();setTimeout(fixEml,1000);}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",startAll);else startAll();})();</script>';
    }

    server {
        listen 5000 default_server;
        server_name _;

        location /security/ {
            proxy_pass http://127.0.0.1:5002/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_read_timeout 120s;
        }
        location = /security {
            return 302 $ingress_prefix/security/;
        }

        location ~ ^/api/hassio_ingress/[^/]+/security/(?<secrest>.*)$ {
            proxy_pass http://127.0.0.1:5002/$secrest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        location ~ ^/api/hassio_ingress/[^/]+(?<rest>/.*)$ {
            proxy_pass http://127.0.0.1:5001$rest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;
            proxy_cookie_path / $ingress_prefix/;
            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter '</body>' '$ha_sec_inject</body>';
            sub_filter '</BODY>' '$ha_sec_inject</BODY>';
        }

        location / {
            proxy_pass http://127.0.0.1:5001;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix $ingress_prefix;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;

            proxy_cookie_path / $ingress_prefix/;

            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter '</body>' '$ha_sec_inject</body>';
            sub_filter '</BODY>' '$ha_sec_inject</BODY>';
        }
    }
}

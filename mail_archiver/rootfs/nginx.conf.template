worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Ingress path from Home Assistant (empty when not behind ingress)
    map $http_x_ingress_path $ingress_prefix {
        default $http_x_ingress_path;
        ''      '';
    }

    server {
        listen 5000 default_server;
        server_name _;

        location / {
            proxy_pass http://127.0.0.1:5001;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_buffering on;
            proxy_read_timeout 3600s;

            # Rewrite absolute redirects so they stay under the ingress path
            proxy_redirect ~^https?://[^/]+(/.*)$ $ingress_prefix$1;
            proxy_redirect ~^(/.*)$ $ingress_prefix$1;

            # Rewrite HTML/JS/CSS links for Home Assistant Ingress
            # (standard ngx_http_sub_module — no lua required)
            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript application/json;
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/' "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/' "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/' "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter '"/' '"$ingress_prefix/';
        }
    }
}

worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    client_max_body_size 0;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    server {
        listen 5000 default_server;
        server_name _;

        location / {
            proxy_pass http://127.0.0.1:5001;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 3600s;

            proxy_redirect ~^https?://[^/]+(/.*) $http_x_ingress_path$1;
            proxy_redirect ~^(/.*) $http_x_ingress_path$1;

            header_filter_by_lua_block {
                ngx.header.content_length = nil
            }
            body_filter_by_lua_block {
                local prefix = ngx.var.http_x_ingress_path
                local data = ngx.arg[1]
                if prefix and prefix ~= "" and data and data ~= "" then
                    data = data:gsub('href="/', 'href="' .. prefix .. '/')
                    data = data:gsub("href='/", "href='" .. prefix .. "/")
                    data = data:gsub('src="/', 'src="' .. prefix .. '/')
                    data = data:gsub("src='/", "src='" .. prefix .. "/")
                    data = data:gsub('action="/', 'action="' .. prefix .. '/')
                    data = data:gsub('fetch%("/", 'fetch("' .. prefix .. '/')
                    data = data:gsub("fetch%('/", "fetch('" .. prefix .. "/")
                    ngx.arg[1] = data
                end
            }
        }
    }
}

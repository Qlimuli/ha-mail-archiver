worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    map $http_x_ingress_path $ingress_prefix {
        default $http_x_ingress_path;
        ""      "";
    }

    server {
        listen 5000 default_server;
        server_name _;

        # Virenschutz – Teil der normalen Oberfläche
        location /security/ {
            proxy_pass http://127.0.0.1:5002/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_read_timeout 120s;
        }
        location = /security {
            return 302 $ingress_prefix/security/;
        }

        location ~ ^/api/hassio_ingress/[^/]+/security/(?<secrest>.*)$ {
            proxy_pass http://127.0.0.1:5002/$secrest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        location ~ ^/api/hassio_ingress/[^/]+(?<rest>/.*)$ {
            proxy_pass http://127.0.0.1:5001$rest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering on;
            proxy_read_timeout 3600s;
            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;
            proxy_cookie_path / $ingress_prefix/;
            sub_filter_once off;
            sub_filter_types text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            # Menüpunkt "Virenschutz" in die normale Navbar einfügen
            sub_filter '</body>' '<script>(function(){try{if(document.getElementById("ha-sec-nav"))return;var ul=document.querySelector("ul.navbar-nav");if(!ul)return;var li=document.createElement("li");li.className="nav-item";li.id="ha-sec-nav";var a=document.createElement("a");a.className="nav-link";a.href="security/";a.innerHTML="<i class=\"bi bi-shield-check me-1\"></i>Virenschutz";li.appendChild(a);ul.appendChild(li);}catch(e){}})();</script></body>';
        }

        location / {
            proxy_pass http://127.0.0.1:5001;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix $ingress_prefix;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_buffering on;
            proxy_read_timeout 3600s;

            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;

            proxy_cookie_path / $ingress_prefix/;

            sub_filter_once off;
            sub_filter_types text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter '</body>' '<script>(function(){try{if(document.getElementById("ha-sec-nav"))return;var ul=document.querySelector("ul.navbar-nav");if(!ul)return;var li=document.createElement("li");li.className="nav-item";li.id="ha-sec-nav";var a=document.createElement("a");a.className="nav-link";a.href="security/";a.innerHTML="<i class=\"bi bi-shield-check me-1\"></i>Virenschutz";li.appendChild(a);ul.appendChild(li);}catch(e){}})();</script></body>';
        }
    }
}

worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    map $http_x_ingress_path $ingress_prefix {
        default $http_x_ingress_path;
        ""      "";
    }

    # Script: Virenschutz-Menü nur für Admins (Navbar enthält "Benutzer")
    # eingefügt vor </body> auf allen App-Seiten
    map $host $ha_sec_inject {
        default '<script id="ha-sec-inject">(function(){function go(){try{if(document.getElementById("ha-sec-nav"))return;var nav=document.querySelector("nav")||document.querySelector("header");if(!nav)return;if(!/Benutzer|Users/i.test(nav.textContent||""))return;var anchors=[].slice.call(nav.querySelectorAll("a"));var proto=null;for(var i=0;i<anchors.length;i++){var t=(anchors[i].textContent||"").replace(/\s+/g," ").trim();if(/Protokoll|Logs?/i.test(t)){proto=anchors[i];break;}}var a=document.createElement("a");a.id="ha-sec-nav";a.href="security/";a.innerHTML="<i class=\"bi bi-shield-check me-1\"></i>Virenschutz";if(proto){a.className=proto.className||"nav-link";var p=proto.parentElement;if(p&&p.tagName==="LI"){var li=document.createElement("li");li.className=p.className||"nav-item";li.appendChild(a);p.parentElement.insertBefore(li,p.nextSibling);}else{proto.parentElement.insertBefore(a,proto.nextSibling);}}else{var ul=nav.querySelector("ul");a.className="nav-link";if(ul){var li2=document.createElement("li");li2.className="nav-item";li2.appendChild(a);ul.appendChild(li2);}else{nav.appendChild(a);}}}catch(e){}}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",go);else go();})();</script>';
    }

    server {
        listen 5000 default_server;
        server_name _;

        location /security/ {
            proxy_pass http://127.0.0.1:5002/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_read_timeout 120s;
        }
        location = /security {
            return 302 $ingress_prefix/security/;
        }

        location ~ ^/api/hassio_ingress/[^/]+/security/(?<secrest>.*)$ {
            proxy_pass http://127.0.0.1:5002/$secrest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        location ~ ^/api/hassio_ingress/[^/]+(?<rest>/.*)$ {
            proxy_pass http://127.0.0.1:5001$rest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering on;
            proxy_read_timeout 3600s;
            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;
            proxy_cookie_path / $ingress_prefix/;
            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter '</body>' '$ha_sec_inject</body>';
            sub_filter '</BODY>' '$ha_sec_inject</BODY>';
        }

        location / {
            proxy_pass http://127.0.0.1:5001;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix $ingress_prefix;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_buffering on;
            proxy_read_timeout 3600s;

            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;

            proxy_cookie_path / $ingress_prefix/;

            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
            sub_filter '</body>' '$ha_sec_inject</body>';
            sub_filter '</BODY>' '$ha_sec_inject</BODY>';
        }
    }
}

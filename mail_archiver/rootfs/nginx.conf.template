worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    # HA sets X-Ingress-Path e.g. /api/hassio_ingress/<token>
    map $http_x_ingress_path $ingress_prefix {
        default $http_x_ingress_path;
        ""      "";
    }

    server {
        listen 5000 default_server;
        server_name _;

        # If a client hits the mapped host port with the full ingress URL
        # (Location rewrite resolved against :5000), strip the prefix.
        location ~ ^/api/hassio_ingress/[^/]+(?<rest>/.*)$ {
            proxy_pass http://127.0.0.1:5001$rest$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering on;
            proxy_read_timeout 3600s;
            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;
            proxy_cookie_path / $ingress_prefix/;
            sub_filter_once off;
            sub_filter_types text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
        }

        location / {
            proxy_pass http://127.0.0.1:5001;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix $ingress_prefix;
            proxy_set_header X-Ingress-Path $http_x_ingress_path;
            proxy_set_header Accept-Encoding "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_buffering on;
            proxy_read_timeout 3600s;

            # Rewrite Location headers so redirects stay under ingress
            proxy_redirect / $ingress_prefix/;
            proxy_redirect http://$host/ $ingress_prefix/;
            proxy_redirect http://$host:5000/ $ingress_prefix/;
            proxy_redirect http://127.0.0.1:5001/ $ingress_prefix/;

            # Auth cookie must be scoped to the ingress path
            proxy_cookie_path / $ingress_prefix/;

            # HTML/JS path rewrite for absolute URLs from the app
            sub_filter_once off;
            sub_filter_types text/css application/javascript application/json;
            sub_filter '<head>' '<head><base href="$ingress_prefix/">';
            sub_filter 'href="/' 'href="$ingress_prefix/';
            sub_filter "href='/'" "href='$ingress_prefix/";
            sub_filter 'src="/' 'src="$ingress_prefix/';
            sub_filter "src='/'" "src='$ingress_prefix/";
            sub_filter 'action="/' 'action="$ingress_prefix/';
            sub_filter "action='/'" "action='$ingress_prefix/";
            sub_filter 'url(/' 'url($ingress_prefix/';
            sub_filter 'fetch("/' 'fetch("$ingress_prefix/';
            sub_filter "fetch('/" "fetch('$ingress_prefix/";
        }
    }
}
